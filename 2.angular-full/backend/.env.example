# Copy to .env. Never commit .env.
GOOGLE_API_KEY=your-gemini-api-key
MODEL=gemini-2.5-flash
APP_NAME=angular-full
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO

# memory | sqlite   (sqlite persists conversations across restarts)
SESSION_BACKEND=memory
SESSION_DB_URL=sqlite+aiosqlite:///./data/generated/sessions.db

# app database the agent queries (auto-created and seeded)
DB_PATH=./data/generated/app.db

# RAG: hashing|gemini embedder, memory|chroma store
KNOWLEDGE_DIR=./data/knowledge
EMBEDDER=hashing
VECTOR_STORE=memory
RAG_TOP_K=3

# MCP: stdio (spawn app/mcp/server.py) | http (connect to MCP_URL) | off
MCP_TRANSPORT=stdio
MCP_URL=http://localhost:8001/mcp
