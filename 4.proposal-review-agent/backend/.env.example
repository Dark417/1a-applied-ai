# Copy to .env. Never commit .env. Every option: app/config.py and docs/design/02-data-model.md.
# This file = "lite" local mode: no Docker, one SQLite file + JSON doc store + local blobs.
# docker-compose overrides the storage settings to Postgres+pgvector and MongoDB.

# --- model: plug in ONE of these ---
# (a) Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key
# (b) Vertex AI with `gcloud auth application-default login`
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

MODEL=gemini-2.5-flash
EMBEDDER=gemini                      # gemini | hashing (offline, lexical only)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- storage (lite) ---
DATABASE_URL=sqlite+aiosqlite:///./data/generated/app.db
VECTOR_STORE=sql                     # sql | pgvector
DOC_STORE=file                       # file | mongo
DOC_STORE_PATH=./data/generated/documents.json
BLOB_STORE=local                     # local | gcs
BLOB_DIR=./data/generated/blobs
ARTIFACT_DIR=./data/generated/artifacts
MEMORY_BACKEND=sql                   # sql | vertex

# --- auth ---
AUTH_MODE=dev                        # dev (trusts X-User-Email) | iap
DEV_DEFAULT_USER=user@example.com
# ADK's dev UI always uses user_id "user"; listing it here makes the dev UI an admin session.
ADMIN_USERS=admin@example.com,user
SERVICE_TOKENS=local-mcp-token       # the MCP server sends this as X-Service-Token

# --- misc ---
ENABLE_ADK_WEB=true                  # ADK dev UI at /dev-ui (no auth: off in production)
CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=INFO
