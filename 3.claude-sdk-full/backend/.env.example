# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=your-anthropic-api-key
MODEL=claude-opus-5
JUDGE_MODEL=claude-opus-5
EFFORT=medium
MAX_TURNS=20
APP_NAME=claude-sdk-full
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO

# the Claude Agent SDK keeps session transcripts under here
WORKDIR=./data/generated/agent

# app database the agent queries (auto-created and seeded)
DB_PATH=./data/generated/app.db

# RAG: hashing|voyage embedder, memory|chroma store
KNOWLEDGE_DIR=./data/knowledge
EMBEDDER=hashing
VECTOR_STORE=memory
RAG_TOP_K=3

# external MCP server: stdio (SDK spawns app/mcp/server.py) | http (connect to MCP_URL) | off
MCP_TRANSPORT=stdio
MCP_URL=http://localhost:8001/mcp
