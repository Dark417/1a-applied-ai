# Copy to .env. Every variable is documented in app/config.py and docs/design/03-cloud-branches.md.

# --- raw: direct APIs (set at least one) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
RAW_VENDOR=anthropic            # anthropic | gemini (adk, langgraph, strands)
ANTHROPIC_MODEL=claude-opus-5
GEMINI_MODEL=gemini-2.5-flash

# --- bedrock: AWS (credentials from the default chain: profile, SSO, role, env) ---
AWS_REGION=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_ANTHROPIC_MODEL=anthropic.claude-opus-5
BEDROCK_CLAUDE_CODE_MODEL=
AGENTCORE_MEMORY_ID=            # infra/aws/setup_agentcore.py prints it
BEDROCK_KB_ID=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
AGENTCORE_BROWSER=false
AGENTCORE_CODE_INTERPRETER=false

# --- vertex: GCP (credentials: gcloud auth application-default login) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_VENDOR=gemini            # gemini | anthropic (Claude on Vertex)
VERTEX_GEMINI_MODEL=gemini-2.5-flash
VERTEX_CLAUDE_MODEL=claude-opus-5
VERTEX_CLAUDE_REGION=global
AGENT_ENGINE_ID=                # infra/gcp/setup_vertex.py prints it
VERTEX_RAG_CORPUS=
MODEL_ARMOR_TEMPLATE=

# --- tools ---
PLAYWRIGHT_CHROMIUM_PATH=       # e.g. /opt/pw-browsers/chromium; empty = Playwright's own
BROWSER_ALLOWED_HOSTS=
PLAYWRIGHT_MCP_ENABLED=false    # needs node/npx

# --- state / cache server (docs/design/07-state-and-memory.md) ---
REDIS_URL=                      # redis://localhost:6379/0; rediss:// for ElastiCache TLS; empty = in-process
SESSION_LOCK_TTL_S=300
LLM_CACHE_TTL_S=3600
LANGGRAPH_CHECKPOINTER=agentcore   # bedrock: agentcore | dynamodb | valkey | sqlite
DYNAMODB_CHECKPOINT_TABLE=ai-sdk-checkpoints
S3_CHECKPOINT_BUCKET=
VALKEY_URL=                     # ElastiCache for Valkey; defaults to REDIS_URL

# --- observability ---
OTEL_EXPORTER=none              # none | console | otlp | gcp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
